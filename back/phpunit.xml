<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!--
            Las pruebas usan el mismo motor que produccion (SQL Server) en lugar
            de SQLite. SQLite no reproduce el comportamiento de LIKE, que en
            SQL Server y en MySQL es insensible a mayusculas por defecto (por
            las collations _CI_AS y _ci) y en SQLite depende de la collation. Esa
            diferencia es justamente la que sostiene la busqueda del reporte de
            inventario. Ademas SQL Server devuelve los enteros de las columnas
            numericas como string, igual que MySQL, y ese fue el origen del bug
            de cast de stock que estas pruebas cubren.

            Apuntan a una base APARTE porque RefreshDatabase ejecuta
            migrate:fresh. Sobre la base de la aplicacion eso borraria los
            datos de trabajo y el usuario de administrador en cada corrida de
            pruebas.
        -->
        <!--
            La base de pruebas se fija en tests/bootstrap.php, no aqui. Dentro
            de Docker la variable DB_DATABASE ya viene definida por el env_file
            del compose y el cargador de entorno de Laravel es inmutable, de
            modo que ni <env> con force ni un .env.testing la sobreescriben.
            El bootstrap se ejecuta antes de que la aplicacion arranque.

            SQL Server y no SQLite a proposito: SQLite no reproduce el LIKE
            insensible a mayusculas que sostiene la busqueda del reporte.
        -->
        <env name="DB_CONNECTION" value="sqlsrv"/>
        <env name="DB_DATABASE" value="farmacia_testing"/>
    </php>
</phpunit>

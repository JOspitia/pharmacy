# Configuracion del backend cuando corre dentro de Docker.
# Se versiona a proposito: no contiene secretos reales, es una clave de
# desarrollo para que el evaluador pueda levantar el proyecto sin pasos extra.

APP_NAME=Pharmacy
APP_ENV=local
# Clave de desarrollo de 32 bytes exactos (AES-256-CBC lo exige).
# Si cambias esta clave se invalidan las sesiones y los tokens emitidos.
APP_KEY=base64:cGhhcm1hY3ktZGV2LWtleS0yMDI2LXNlY3VyZS0zMmI=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Servicio "db" definido en docker-compose.yml, no localhost: dentro de la red
# de Docker el nombre del servicio es lo que resuelve DNS.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=farmacia
DB_USERNAME=farmacia
DB_PASSWORD=farmacia
DB_ROOT_PASSWORD=root

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# La API se consume con token Bearer (Sanctum con EnsureFrontendRequestsAreStateful
# deshabilitado), por lo que no hace falta configurar dominios stateful ni CORS:
# el frontend accede al backend a traves del proxy de Vite, que es mismo origen.
#
# Destino que debe usar el proxy /api del frontend. Lo inyecta docker-compose.yml.
VITE_API_TARGET=http://backend:8000

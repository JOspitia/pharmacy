# Configuracion de referencia para la instalacion MANUAL (sin Docker).
# Es el mismo archivo que back/.env.docker con una sola diferencia: DB_HOST.
#
#   aqui        -> 127.0.0.1   (MySQL corriendo en tu maquina)
#   .env.docker -> db          (servicio de MySQL dentro de docker compose)
#
# Si clonaste el repositorio y vas a usar Docker, no necesitas este archivo:
# `docker compose up --build` ya toma .env.docker y funciona sin pasos extra.

APP_NAME=Pharmacy
APP_ENV=local
# Clave de desarrollo de 32 bytes exactos (AES-256-CBC lo exige). Si prefieres
# generar la tuya: php artisan key:generate
APP_KEY=base64:cGhhcm1hY3ktZGV2LWtleS0yMDI2LXNlY3VyZS0zMmI=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlsrv
DB_HOST=127.0.0.1
DB_PORT=1433
DB_DATABASE=farmacia
DB_USERNAME=sa
DB_PASSWORD=YourStrong!Passw0rd
# SQL Server no separa un usuario root: el unico superusuario es sa.

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# La API se consume con token Bearer (Sanctum con EnsureFrontendRequestsAreStateful
# deshabilitado), por lo que no hace falta configurar dominios stateful ni CORS:
# el frontend accede al backend a traves del proxy de Vite, que es mismo origen.
#
# Destino del proxy /api del frontend cuando corre fuera de Docker.
VITE_API_TARGET=http://localhost:8000
